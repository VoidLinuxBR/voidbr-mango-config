#!/usr/bin/env bash
# ====================================================================
# VoidBR Mango - Historico da area de transferencia (cliphist + rofi)
# Clique-direito/Shift+Delete nao existem no dmenu, entao:
#   voidbr-clipboard        -> escolher e copiar
#   voidbr-clipboard limpar -> apagar todo o historico
# ====================================================================
if [ "$1" = limpar ]; then
    cliphist wipe && notify-send "Área de transferência" "Histórico apagado"
    exit 0
fi
cliphist list | voidbr-rofi -dmenu -i -p "Clipboard" -display-columns 2 | cliphist decode | wl-copy

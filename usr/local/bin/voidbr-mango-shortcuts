        ("Super + Tab", _("Próxima janela")),
        ("Alt + Tab", _("Saltar entre janelas")),
        ("Alt + ← ↑ ↓ →", _("Mover foco por direção")),
        ("Super + Shift + ← ↑ ↓ →", _("Trocar janela de lugar")),
        ("Super + I", _("Minimizar janela")),
        ("Super + Shift + I", _("Restaurar janela minimizada")),
        ("Super + G", _("Janela visível em todas as tags")),
        ("Super + O", _("Janela sempre por cima (overlay)")),
        ("Alt + Z", _("Mostrar / esconder o scratchpad")),
        ("Ctrl + Shift + ← ↑ ↓ →", _("Mover janela flutuante")),
        ("Ctrl + Alt + ← ↑ ↓ →", _("Redimensionar janela")),
    ]),
    (_("Workspaces / Tags"), [
        ("Ctrl + 1..9", _("Ir para tag")),
        ("Alt + 1..9", _("Mover janela para tag")),
        ("Super + ← / →", _("Tag anterior / próxima")),

#!/usr/bin/env bash
# Maintainer: Vilmar Catafesta <vcatafesta@gmail.com>
# Contributor: Wilton (Wiljapa) <wilton.kikkawa@gmail.com>

pkgname=voidbr-mango-config
pkgdesc="Skel config for VoidBR MANGO Meta Package"
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
provides=()
replaces=()
arch=('any')
license=('MIT')
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')
makedepends=()
depends=(
	voidbr-sddm-themes # traz o tema voidbr-mango do SDDM (antes ficava neste pacote)
	'mangowc>=0.18'    # a config usa os nomes de chave do Mango 0.18
)
backup=()

package() {
	# Verify default folder
	if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}/${pkgname}"
	elif [ -d "${srcdir}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}"
	else
		#local
		InternalDir="${WORKDIR}"
	fi

	cd "${InternalDir}"
	# Copiar a estrutura de /etc, /usr e /opt para /
	local dirs=("boot" "etc" "opt" "usr" "var")
	for dir in "${dirs[@]}"; do
		if [ -d "${InternalDir}/${dir}" ]; then
			cp -a "${InternalDir}/${dir}" "${pkgdir}/"
		fi
	done

	# Install license file if present
	[ -f "LICENSE" ] && install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	# Install documentation if present
	[ -f "README.md" ] && install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"

}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	if [ "${update:-}" = "yes" ]; then
		log "Finalizando upgrade"
	else
		log "Finalizando instalação"
	fi

	# O /etc/sddm.conf.d/wayland.conf (greeter em Wayland, compositor sway) é do
	# voidbr-sddm-themes; este pacote não mexe mais nele.

	# Tema do SDDM da edição Mango (o tema voidbr-mango vem no voidbr-sddm-themes).
	# O padrão do pacote fica no /etc/sddm.conf.d/10-theme.conf, que não é
	# alterado; a edição grava o 50-voidbr-theme.conf, o mesmo arquivo da aba
	# "Tela de login" dos voidbr-*-tweaks. Só cria se ainda não existir: se
	# existe, é escolha de alguém e fica como está (o post_upgrade também passa
	# por aqui). No build da ISO (MKISO_BUILD) quem decide o tema é o mkiso
	# (voidbr-mango na ISO mango e na multi); aqui só fora da ISO, para quem
	# instala a edição Mango num sistema já pronto.
	if [ -z "${MKISO_BUILD:-}" ]; then
		# arquivo próprio das versões antigas deste pacote
		rm -f /etc/sddm.conf.d/10-voidbr-mango.conf
		if [ ! -e /etc/sddm.conf.d/50-voidbr-theme.conf ] &&
			[ -d /usr/share/sddm/themes/voidbr-mango ]; then
			mkdir -p /etc/sddm.conf.d
			printf '# voidbr-sddm-theme: tema da tela de login (padrão da edição Mango)\n[Theme]\nCurrent=voidbr-mango\n' \
				>/etc/sddm.conf.d/50-voidbr-theme.conf
			chmod 644 /etc/sddm.conf.d/50-voidbr-theme.conf
		fi
	fi

	# Config do Mango de quem ja tem o usuario criado: chaves com os nomes da versao instalada
	for dir in /home/*/.config/mango /root/.config/mango; do
		[ -d "$dir" ] || continue
		for conf in "$dir"/*.conf; do
			[ -f "$conf" ] && /usr/local/bin/voidbr-compat auto "$conf" || true
		done
		# wireplumber e pipewire-pulse sobem pelo voidbr-session-start (evita rodar em dobro)
		[ -f "$dir/base.conf" ] && sed -i -E '/^exec[-_]once *= *(wireplumber|pipewire-pulse)$/d' "$dir/base.conf"
		# Cursor do Mango igual ao dos apps (Bibata)
		[ -f "$dir/base.conf" ] && ! grep -q '^cursor_theme=' "$dir/base.conf" &&
			sed -i '$a cursor_theme=Bibata-Modern-Ice' "$dir/base.conf"
		# Xicara do Waybar: fumegando = ligada, vazia = desligada
		[ -f "$dir/../waybar/config" ] && sed -i -e 's/"activated": "󰅶"/"activated": ""/' \
			-e 's/"deactivated": "󰅶"/"deactivated": "󰛊"/' "$dir/../waybar/config" || true
	done

	# Skel: mesmo esquema dos outros -config (labwc, river...). Antes a cópia
	# ficava no meta-pacote voidbr-mango, sempre com --force (inclusive no upgrade).
	# Build da ISO e instalador: o skel vai para o usuário criado depois
	if [ -n "${MKISO_BUILD:-}" ] || [ -n "${VOIDBR_INSTALLER:-}" ]; then
		return 0
	fi

	# Cópia do skel (/etc/skel) para o usuário que está instalando/atualizando
	[ -n "${user:-}" ] || return 0
	# rootfs da ISO, chroot do instalador etc.: o usuário de quem gerou o
	# pacote não existe aqui (o skel vai para o usuário criado depois)
	getent passwd "$user" >/dev/null 2>&1 || return 0
	if [ ! -x /usr/local/bin/voidbr-copy-skel-inc ]; then
		log "voidbr-copy-skel-inc nao encontrado: skel nao copiado"
		return 0
	fi

	local resp="t" prompt

	# Instalação nova: copia tudo (o que for diferente vai para backup).
	# Atualização: pergunta, se houver terminal. Sem terminal, ou sem
	# resposta em 30s, não altera nada do que o usuário já tem.
	if [ "${update:-}" = "yes" ]; then
		resp=""
		# O xbps roda este script com /bin/sh (dash), que não tem
		# "read -t/-p"; a pergunta com tempo limite vai pelo bash,
		# lendo direto do terminal. Prefixo no mesmo formato do log().
		if [ -t 1 ] && { : </dev/tty; } 2>/dev/null; then
			# Pergunta em branco, teclas em amarelo (destaca das linhas do log)
			prompt=$(printf '%s[*]%s %s - %s' "$CYAN" "${BLACK}$pkgname" "${RST}" "${WHITE}")
			prompt="${prompt}Configurações de $user: aplicar [${YELLOW}t${WHITE}]odas (com backup) ou só as [${YELLOW}N${WHITE}]ovas? ${RESET}"
			resp=$(bash -c 'read -r -t 30 -p "$1" r </dev/tty >&2 || echo >&2; printf "%s" "$r"' _ "$prompt") || true
		fi
	fi

	case "$resp" in
	t | T | todas | Todas | TODAS)
		# Substitui o que for diferente, com backup em ~/.voidbr-skel-backup-*
		log "Aplicando configuracoes padrao para $user"
		/usr/local/bin/voidbr-copy-skel-inc --user "$user" --force --quiet || true
		;;
	*)
		# Copia só o que ainda não existe no HOME
		log "Aplicando novas configuracoes para $user"
		/usr/local/bin/voidbr-copy-skel-inc --user "$user" --only-new --quiet || true
		;;
	esac
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	post_install
}

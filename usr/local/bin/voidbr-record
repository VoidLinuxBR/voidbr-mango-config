#!/usr/bin/env bash
# ====================================================================
# VoidBR Mango - Gravacao de tela (wf-recorder)
# Uso: voidbr-record area|tela|janela [--som]   -> comeca a gravar
#      voidbr-record parar                      -> para e salva
#      voidbr-record status                     -> JSON para o Waybar
#      voidbr-record --geometry janela|monitor  -> geometria (uso interno)
# Video em ~/Vídeos/Gravações. Usa a GPU (VA-API) se funcionar,
# senao x264 (superfast) no processador. Limitado a 60 fps.
# ====================================================================
DIR="$HOME/Vídeos/Gravações"
STATE="${XDG_RUNTIME_DIR:-/tmp}/voidbr-record"
FPS=60

refresh_bar() { pkill -RTMIN+10 -x waybar 2>/dev/null; }

geometry() {
    case "$1" in
        janela)
            # "x,y WxH" da janela em foco (coordenadas logicas do Mango)
            mmsg get focusing-client | python3 -c '
import json, sys
c = json.load(sys.stdin)
if not c.get("width"):
    sys.exit(1)
print("%d,%d %dx%d" % (c["x"], c["y"], c["width"], c["height"]))'
            ;;
        monitor)
            mmsg get cursorpos | python3 -c 'import json,sys; print(json.load(sys.stdin)["monitor"])'
            ;;
    esac
}

is_recording() {
    [ -f "$STATE" ] && kill -0 "$(sed -n 1p "$STATE")" 2>/dev/null
}

codec_args() {
    # VA-API com H.264 disponivel? (mesa-vaapi + libva-utils)
    if command -v vainfo >/dev/null &&
       vainfo --display drm --device /dev/dri/renderD128 2>/dev/null |
       grep -q "VAProfileH264.*VAEntrypointEncSlice"; then
        echo "-c h264_vaapi -d /dev/dri/renderD128"
    else
        echo "-c libx264 -p preset=superfast -p crf=23 -x yuv420p"
    fi
}

start() {
    mode="$1"; som="$2"
    if is_recording; then
        notify-send "Gravação" "Já existe uma gravação em andamento"
        exit 1
    fi
    if ! command -v wf-recorder >/dev/null; then
        notify-send "Gravação" "Instale o wf-recorder: sudo xbps-install wf-recorder"
        exit 1
    fi
    mkdir -p "$DIR"
    f="$DIR/$(date +%Y-%m-%d_%H%M%S)-$mode.mp4"

    args=(-f "$f" -r "$FPS")
    case "$mode" in
        area)   geom=$(slurp) || exit 0; args+=(-g "$geom") ;;
        janela) geom=$(geometry janela) || exit 1; args+=(-g "$geom") ;;
        *)      args+=(-o "$(geometry monitor)") ;;
    esac
    if [ "$som" = "--som" ]; then
        args+=("--audio=$(pactl get-default-sink).monitor")
    fi
    # shellcheck disable=SC2207
    args+=($(codec_args))

    setsid wf-recorder "${args[@]}" >"$STATE.log" 2>&1 < /dev/null &
    pid=$!
    sleep 0.5
    if ! kill -0 "$pid" 2>/dev/null; then
        notify-send -u critical "Gravação falhou" "$(tail -n 3 "$STATE.log")"
        exit 1
    fi
    printf '%s\n%s\n%s\n%s\n' "$pid" "$(date +%s)" "$f" "$mode${som:+ com som}" > "$STATE"
    refresh_bar
}

stop() {
    is_recording || { rm -f "$STATE"; refresh_bar; exit 0; }
    pid=$(sed -n 1p "$STATE"); f=$(sed -n 3p "$STATE")
    kill -INT "$pid"
    # Espera o wf-recorder fechar o arquivo direito
    for _ in $(seq 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
    rm -f "$STATE"
    refresh_bar
    notify-send "Gravação salva" "$f"
}

status() {
    if is_recording; then
        start_ts=$(sed -n 2p "$STATE"); what=$(sed -n 4p "$STATE")
        s=$(( $(date +%s) - start_ts ))
        printf '{"text": "󰑊 %02d:%02d", "tooltip": "Gravando (%s)\\nClique para parar e salvar", "class": "recording"}\n' \
            $((s / 60)) $((s % 60)) "$what"
    else
        echo '{"text": "", "class": "idle"}'
    fi
}

case "$1" in
    parar)      stop ;;
    status)     status ;;
    --geometry) geometry "$2" ;;
    area|tela|janela) start "$1" "$2" ;;
    *) echo "Uso: voidbr-record area|tela|janela [--som] | parar | status" >&2; exit 1 ;;
esac

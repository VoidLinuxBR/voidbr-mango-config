#!/usr/bin/env bash
# Maintainer: Vilmar Catafesta <vcatafesta@gmail.com>
# Contributor: Wilton (Wiljapa) <wilton.kikkawa@gmail.com>

pkgname=voidbr-mango-config
pkgdesc="Skel config for VoidBR MANGO Meta Package"
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
provides=()
replaces=()
arch=('any')
license=('MIT')
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')
makedepends=()
depends=(
	voidbr-sddm-themes # o tema voidbr-mango reaproveita o código do tema voidbr
	'mangowc>=0.18'    # a config usa os nomes de chave do Mango 0.18
)
backup=(
	/etc/sddm.conf.d/wayland.conf
)

package() {
	# Verify default folder
	if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}/${pkgname}"
	elif [ -d "${srcdir}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}"
	else
		#local
		InternalDir="${WORKDIR}"
	fi

	cd "${InternalDir}"
	# Copiar a estrutura de /etc, /usr e /opt para /
	local dirs=("boot" "etc" "opt" "usr" "var")
	for dir in "${dirs[@]}"; do
		if [ -d "${InternalDir}/${dir}" ]; then
			cp -a "${InternalDir}/${dir}" "${pkgdir}/"
		fi
	done

	# Install license file if present
	[ -f "LICENSE" ] && install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	# Install documentation if present
	[ -f "README.md" ] && install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"

}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	if [ "${update:-}" = "yes" ]; then
		log "Finalizando upgrade"
	else
		log "Finalizando instalação"
	fi

	mkdir -p /etc/sddm.conf.d/
	tee /etc/sddm.conf.d/wayland.conf >/dev/null <<'EOF'
[General]
#CompositorCommand=weston --shell=kiosk
DisplayServer=wayland
EOF

	# Tema do SDDM da edição Mango (fundo e cores do Mango sobre o tema voidbr).
	# O /etc/sddm.conf é lido por último e tem prioridade sobre o sddm.conf.d.
	if [ -f /etc/sddm.conf ] && grep -q '^Current=' /etc/sddm.conf; then
		sed -i 's/^Current=.*/Current=voidbr-mango/' /etc/sddm.conf
	fi
	printf '[Theme]\nCurrent=voidbr-mango\n' >/etc/sddm.conf.d/10-voidbr-mango.conf

	# Config do Mango de quem ja tem o usuario criado: chaves com os nomes da versao instalada
	for dir in /home/*/.config/mango /root/.config/mango; do
		[ -d "$dir" ] || continue
		for conf in "$dir"/*.conf; do
			[ -f "$conf" ] && /usr/local/bin/voidbr-compat auto "$conf" || true
		done
	done
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	post_install
}

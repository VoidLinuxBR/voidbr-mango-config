    ]),
]

# Paleta central (~/.config/voidbr/colors.ini, gerada por voidbr-theme)
PALETTE_CSS = os.path.expanduser("~/.config/voidbr/colors.css")


def themed(css):
    try:
        with open(PALETTE_CSS, "rb") as f:
            return f.read() + css
    except OSError:
        return css

CSS = b"""
window {
    background-color: alpha(@bg, 0.86);
    border: none;
    border-radius: 16px;
}
headerbar {
    background-color: @bg2;
    color: @fg;
    border-bottom: 1px solid @bg3;
}
.title {
    font-size: 16px;
    font-weight: bold;
    color: @accent;
}
searchentry {
    background-color: @bg3;
    color: @fg;
    border: 1px solid @border;
    border-radius: 10px;
    padding: 6px;
}
searchentry:focus-within {
    border-color: @accent;
}
scrolledwindow {
    background-color: transparent;
}
listview, list, listbox {
    background-color: transparent;
}
list row {
    background-color: alpha(@bg3, 0.6);
    border: 1px solid @bg3;
    border-radius: 8px;
    margin: 2px 0px;
    padding: 6px 12px;
}
list row:hover {
    background-color: alpha(@accent, 0.2);
    border-color: @accent;
}
.section {
    font-size: 14px;
    font-weight: bold;
    color: @orange;
    margin-top: 12px;
    margin-bottom: 4px;
}
.key {
    font-family: monospace;
    font-weight: bold;
    color: @cyan;
    background: rgba(0, 0, 0, 0.4);
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid alpha(@cyan, 0.3);
}
.desc {
    color: @fg;
    font-size: 13px;
}
"""

class Win(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=_("Atalhos do VoidBR Mango"))
        self.set_default_size(720, 560)
        self.set_resizable(False)

        css = Gtk.CssProvider()
        css.load_from_data(themed(CSS))
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), css,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        hb = Gtk.HeaderBar()
        title = Gtk.Label(label=_("󰘥 Atalhos do VoidBR Mango"))
        title.add_css_class("title")
        hb.set_title_widget(title)
        self.set_titlebar(hb)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL,
                       spacing=8,
                       margin_top=12, margin_bottom=12,
                       margin_start=16, margin_end=16)

        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text(_("Pesquisar atalho..."))
        root.append(self.search)

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_vexpand(True)
        root.append(scrolled)

        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        self.rows = []
        scrolled.set_child(self.listbox)

        self.search.connect("search-changed", self.filter_rows)

        for section, items in SHORTCUTS:
            lbl = Gtk.Label(xalign=0)
            lbl.set_markup(f"<b>{section}</b>")
            lbl.add_css_class("section")
            row = Gtk.ListBoxRow(selectable=False)
            row.set_child(lbl)
            self.listbox.append(row)
            self.rows.append((row, section.lower()))

            for key, desc in items:
                box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)

                lbl_k = Gtk.Label(label=key, xalign=0)
                lbl_k.add_css_class("key")
                lbl_k.set_size_request(240, -1)
                box.append(lbl_k)

                lbl_d = Gtk.Label(label=desc, xalign=0)
                lbl_d.add_css_class("desc")
                lbl_d.set_hexpand(True)
                box.append(lbl_d)

                r = Gtk.ListBoxRow(selectable=False)
                r.set_child(box)
                self.listbox.append(r)
                self.rows.append((r, f"{key} {desc}".lower()))

        key_ctrl = Gtk.EventControllerKey()
        key_ctrl.connect("key-pressed", self.on_key)
        self.add_controller(key_ctrl)

        self.set_child(root)

    def on_key(self, ctrl, keyval, keycode, state):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def filter_rows(self, entry):
        text = entry.get_text().lower().strip()
        for row, content in self.rows:
            if not text or text in content:
                row.set_visible(True)
            else:
                row.set_visible(False)

class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="io.voidbr.mango.shortcuts")

    def do_activate(self):
        # Abrir de novo (botao da barra ou atalho) com a janela aberta: fecha
        if self.props.active_window:
            self.quit()
            return
        win = Win(self)
        win.present()
        # Clique fora da janela tambem fecha
        subprocess.Popen(["voidbr-click-outside", str(os.getpid())])

if __name__ == "__main__":
    app = App()
    app.run(sys.argv)

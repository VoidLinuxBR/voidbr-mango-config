#!/usr/bin/env python3
# ====================================================================
# VoidBR Mango - Fecha um popup quando se clica fora dele
# Uso: voidbr-click-outside <pid>
#
# Cobre a tela (inclusive a barra) com uma camada invisivel logo abaixo
# do popup. O popup fica acima dela pela regra "isoverlay" do Mango. Um
# clique fora encerra o <pid>; clicar de novo no botao da barra cai aqui
# tambem, entao o mesmo botao abre e fecha. Sai sozinho quando o <pid>
# termina. Nao usa a perda de foco porque o Mango usa sloppyfocus.
# ====================================================================
import os
import signal
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import GLib, Gtk, GtkLayerShell

NAMESPACE = "voidbr-click-outside"


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def main():
    try:
        pid = int(sys.argv[1])
    except (IndexError, ValueError):
        sys.exit("uso: voidbr-click-outside <pid>")

    win = Gtk.Window()
    GtkLayerShell.init_for_window(win)
    GtkLayerShell.set_namespace(win, NAMESPACE)
    GtkLayerShell.set_layer(win, GtkLayerShell.Layer.TOP)
    for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                 GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
        GtkLayerShell.set_anchor(win, edge, True)
    GtkLayerShell.set_exclusive_zone(win, -1)  # cobre a barra tambem
    GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.NONE)

    css = Gtk.CssProvider()
    css.load_from_data(b"window { background-color: rgba(0, 0, 0, 0); }")
    Gtk.StyleContext.add_provider_for_screen(
        win.get_screen(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    visual = win.get_screen().get_rgba_visual()
    if visual:
        win.set_visual(visual)

    def close(*_):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        Gtk.main_quit()

    def watch():
        if not alive(pid):
            Gtk.main_quit()
            return False
        return True

    win.connect("button-press-event", close)
    win.connect("destroy", Gtk.main_quit)
    GLib.timeout_add(250, watch)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()

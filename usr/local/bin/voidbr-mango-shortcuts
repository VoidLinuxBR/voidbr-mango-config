        ("Super + Alt + ← / →", _("Levar janela para outro monitor")),
    ]),
    (_("Layouts e Tiling"), [
        ("Super / Alt + L", _("Abrir menu gráfico de layouts")),
        ("Super + N", _("Ciclar para o próximo layout")),

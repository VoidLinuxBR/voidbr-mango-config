#!/usr/bin/env python3
import gettext
import os
import subprocess
import sys
import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gtk, Gdk

APPNAME = "voidbr-shortcuts"
LOCALEDIR = "/usr/share/locale"

gettext.bindtextdomain(APPNAME, LOCALEDIR)
gettext.textdomain(APPNAME)
_ = gettext.gettext

SHORTCUTS = [
    (_("Sistema"), [
        ("Super + R", _("Recarregar configuração")),
        ("Super + M", _("Encerrar sessão")),
        ("Super + Esc", _("Bloquear tela (hyprlock)")),
        ("Super + F1", _("Janela de ajuda de atalhos")),
        ("Super + Shift + T", _("Trocar tema de cores")),
    ]),
    (_("Aplicativos"), [
        ("Super / Alt + Return", _("Abrir terminal (foot)")),
        ("Super / Alt + Space", _("Lançador de aplicativos (Rofi)")),
        ("Super / Alt + W", _("Galeria de Papéis de Parede")),
        ("Super + V", _("Histórico da área de transferência")),
    ]),
    (_("Captura e Gravação"), [
        ("Print", _("Captura da tela inteira (salva e copia)")),
        ("Super + Shift + S", _("Captura de área (abre no satty para anotar)")),
        ("Super + Shift + R", _("Menu de captura e gravação; gravando: parar e salvar")),
    ]),
    (_("Janelas e Foco"), [
        ("Super / Alt + Q", _("Fechar janela ativa")),
        ("Super / Alt + F", _("Alternar tela cheia")),
        ("Super / Alt + Shift + F", _("Tela cheia falsa (dentro do espaço da janela)")),
        ("Super / Alt + A", _("Alternar maximizar")),
